<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.1</Version>
    <ApplicationIcon>Assets\diagnostico-lag.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\diagnostico-lag.ico">
      <LogicalName>DiagnosticoLag.Assets.diagnostico-lag.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="RebuildApplicationWhenIconChanges"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(ApplicationIcon)' != ''"
          Inputs="$(MSBuildProjectDirectory)\$(ApplicationIcon)"
          Outputs="$(IntermediateOutputPath)$(AssemblyName).ApplicationIcon">
    <Delete Files="$(IntermediateOutputPath)$(TargetName)$(TargetExt)" />
    <Delete Files="$(IntermediateOutputPath)apphost.exe" />
    <Touch Files="$(IntermediateOutputPath)$(AssemblyName).ApplicationIcon" AlwaysCreate="true" />
  </Target>
</Project>
